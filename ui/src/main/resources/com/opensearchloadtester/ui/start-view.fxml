<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<ScrollPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.opensearchloadtester.ui.StartController"
            fitToWidth="true">
    <VBox spacing="20.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ImageView fitHeight="130.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@loadtester-logo-transparent.png"/>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>

            <Label text="OpenSearch Loadtester UI" textAlignment="CENTER">
                <font>
                    <Font name="Calibri Bold" size="27.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox.margin>
                <Insets bottom="30.0"/>
            </VBox.margin>
        </HBox>

        <Label text="Please select test-data generation document type:"/>
        <ComboBox fx:id="testdataGenerationDocumentType" prefWidth="290.0" promptText="Please select document type"/>

        <Label text="Please select the scenario, that should be executed:"/>
        <ComboBox fx:id="scenarioConfig" prefWidth="290.0" promptText="Please enter scenario"/>
        <VBox fx:id="customScenarioConfigurationBox" disable="true" managed="false" visible="false">
            <HBox alignment="CENTER_LEFT">
                <Label text="Schedule duration:">
                    <HBox.margin>
                        <Insets right="20.0"/>
                    </HBox.margin>
                </Label>
                <TextField fx:id="customScheduleDurationAmount" prefWidth="60.0" promptText="e.g. 30">
                    <HBox.margin>
                        <Insets right="10.0"/>
                    </HBox.margin>
                </TextField>
                <ComboBox fx:id="customScheduleDurationUnit"/>
                <Label layoutX="10.0" layoutY="14.0" text="QPS:">
                    <HBox.margin>
                        <Insets left="50.0" right="20.0"/>
                    </HBox.margin>
                </Label>
                <TextField fx:id="customQps" layoutX="120.0" layoutY="10.0" promptText="e.g. 20"/>
                <VBox.margin>
                    <Insets bottom="10.0"/>
                </VBox.margin>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Query response timeout">
                    <HBox.margin>
                        <Insets right="20.0"/>
                    </HBox.margin>
                </Label>
                <TextField fx:id="customQueryResponseTimeoutAmount" prefWidth="60.0" promptText="e.g. 30">
                    <HBox.margin>
                        <Insets right="10.0"/>
                    </HBox.margin>
                </TextField>
                <ComboBox fx:id="customQueryResponseTimeoutUnit"/>
                <Label layoutX="10.0" layoutY="14.0" text="Warmup:">
                    <HBox.margin>
                        <Insets left="50.0" right="20.0"/>
                    </HBox.margin>
                </Label>
                <ComboBox fx:id="customWarmup" promptText="select"/>
                <VBox.margin>
                    <Insets bottom="10.0"/>
                </VBox.margin>
            </HBox>
            <VBox fx:id="dynamicCheckboxWrapper" spacing="10.0"/>
        </VBox>

        <Label text="Please select test-data generation mode:"/>
        <ComboBox fx:id="testdataGenerationMode" prefWidth="290.0"
                  promptText="Please select test-data generation mode"/>
        <Label fx:id="persistentModeWarning" managed="false" visible="false" wrapText="true"
               style="-fx-text-fill: #D4A017; -fx-font-style: italic;"
               text="⚠ Persistent mode is currently in beta. Using a very high test-data generation count may lead to memory issues. It is recommended to keep the count low or use DYNAMIC mode instead.">
            <VBox.margin>
                <Insets top="-10.0"/>
            </VBox.margin>
        </Label>

        <Label text="Please enter test-data generation count:"/>
        <TextField fx:id="testdataGenerationCount" prefHeight="26.0" prefWidth="208.0"
                   promptText="Please enter test-data generation count"/>

        <Label text="Please enter test-data generation batch size:"/>
        <TextField fx:id="testdataGenerationBatchSize" prefHeight="26.0" prefWidth="208.0"
                   promptText="Please enter test-data generation batch size"/>

        <Label text="Please enter load-generator replica amount:"/>
        <TextField fx:id="loadGeneratorReplicas" prefHeight="26.0" prefWidth="197.0"
                   promptText="Please enter load-generator replica amount"/>

        <Label text="Please enter metrics batch size:"/>
        <TextField fx:id="metricsBatchSize" prefHeight="26.0" prefWidth="197.0"
                   promptText="Please enter metrics batch size"/>
        <TextArea fx:id="outputText" editable="false" managed="false" prefHeight="200.0" prefWidth="200.0"
                  visible="false"/>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <Button mnemonicParsing="false" onAction="#onStartLoadTest">
                <graphic>
                    <Label style="-fx-font-size:14;" text="Start Load Test" textFill="black"/>
                </graphic>
                <style>
                    -fx-background-color: #B2BEB5;
                    -fx-background-radius: 15;
                    -fx-cursor: hand;
                </style>
                <HBox.margin>
                    <Insets right="30.0"/>
                </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onCloseButtonClick">
                <graphic>
                    <Label style="-fx-font-size:14;" text="Kill container(s)" textFill="black"/>
                </graphic>
                <style>
                    -fx-background-color: #FF5C5C;
                    -fx-background-radius: 15;
                    -fx-cursor: hand;
                </style>
            </Button>
        </HBox>
    </VBox>
</ScrollPane>
