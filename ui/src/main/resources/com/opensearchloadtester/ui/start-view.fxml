<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.opensearchloadtester.ui.StartController"
            fitToWidth="true"
            style="-fx-background-color: #F0F2F5;"
            onKeyPressed="#onKeyPressed">
    <VBox spacing="25.0">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <ImageView fx:id="logoImage" fitHeight="120" fitWidth="180" pickOnBounds="true" preserveRatio="true"
                       onMouseClicked="#onLogoClick">
                <Image url="@loadtester-logo-transparent.png"/>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="OpenSearch Loadtester UI"
                   style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 30; -fx-text-fill: #2C3E50;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="20"
              style="-fx-background-color: #FFFFFF; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 5);">

            <Label text="Please select test-data generation document type:"
                   style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <ComboBox fx:id="testdataGenerationDocumentType" prefWidth="320" promptText="Please select document type"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #BDC3C7; -fx-font-size: 14;"/>

            <Label text="Please select the scenario, that should be executed:"
                   style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <ComboBox fx:id="scenarioConfig" prefWidth="320" promptText="Please enter scenario"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #BDC3C7; -fx-font-size: 14;"/>

            <VBox fx:id="customScenarioConfigurationBox" disable="true" managed="false" visible="false" spacing="15">
                <HBox spacing="15">
                    <Label text="Schedule duration:" style="-fx-font-size: 13;"/>
                    <TextField fx:id="customScheduleDurationAmount" prefWidth="60" promptText="30"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
                    <ComboBox fx:id="customScheduleDurationUnit"/>
                    <Label text="QPS:" style="-fx-font-size: 13;"/>
                    <TextField fx:id="customQps" promptText="20"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
                </HBox>
                <HBox spacing="15">
                    <Label text="Query response timeout:" style="-fx-font-size: 13;"/>
                    <TextField fx:id="customQueryResponseTimeoutAmount" prefWidth="60" promptText="30"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
                    <ComboBox fx:id="customQueryResponseTimeoutUnit"/>
                    <Label text="Warmup:" style="-fx-font-size: 13;"/>
                    <ComboBox fx:id="customWarmup" promptText="select"/>
                </HBox>
                <VBox fx:id="dynamicCheckboxWrapper" spacing="10"/>
            </VBox>

            <Label text="Please select test-data generation mode:" style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <ComboBox fx:id="testdataGenerationMode" prefWidth="320"
                      promptText="Please select test-data generation mode"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #BDC3C7; -fx-font-size: 14;"/>

            <Label fx:id="persistentModeWarning" managed="false" visible="false" wrapText="true"
                   style="-fx-text-fill: #E67E22; -fx-font-style: italic; -fx-font-size: 13;"
                   text="⚠ Persistent mode is currently in beta. Using a very high test-data generation count may lead to memory issues. It is recommended to keep the count low or use DYNAMIC mode instead."/>

            <Label text="Please enter test-data generation count:" style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <TextField fx:id="testdataGenerationCount" prefHeight="32" prefWidth="220" promptText="Enter count"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 14;"/>

            <Label text="Please enter test-data generation batch size:"
                   style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <TextField fx:id="testdataGenerationBatchSize" prefHeight="32" prefWidth="220" promptText="Enter batch size"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 14;"/>

            <Label text="Please enter load-generator replica amount:"
                   style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <TextField fx:id="loadGeneratorReplicas" prefHeight="32" prefWidth="220" promptText="Enter replicas"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 14;"/>

            <Label text="Please enter metrics batch size:" style="-fx-font-size: 14; -fx-text-fill: #34495E;"/>
            <TextField fx:id="metricsBatchSize" prefHeight="32" prefWidth="220" promptText="Enter metrics batch size"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 14;"/>

            <TextArea fx:id="outputText" editable="false" managed="false" prefHeight="300" prefWidth="200"
                      visible="false" wrapText="true"
                      style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 12px; -fx-background-color: #ECF0F1; -fx-border-color: #BDC3C7; -fx-border-radius: 8;"/>

        </VBox>

        <HBox fx:id="buttonBox" alignment="CENTER" spacing="25">
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartLoadTest"
                    onMouseEntered="#onHoverStart" onMouseExited="#onHoverExit"
                    style="-fx-background-color: #3498DB; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand;">
                <graphic>
                    <Label text="Start Load Test" textFill="white" style="-fx-font-weight:bold;"/>
                </graphic>
            </Button>

            <Button fx:id="killButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
                    onMouseEntered="#onHoverStartKill" onMouseExited="#onHoverExitKill"
                    style="-fx-background-color: #E74C3C; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand;">
                <graphic>
                    <Label text="Kill container(s)" textFill="white" style="-fx-font-weight:bold;"/>
                </graphic>
            </Button>
        </HBox>

    </VBox>
</ScrollPane>
